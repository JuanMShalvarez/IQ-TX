    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [176, 360.0]
    rotation: 0
    state: enabled
- name: blocks_float_to_complex_0
  id: blocks_float_to_complex
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 352.0]
    rotation: 0
    state: enabled
- name: blocks_multiply_const_vxx_0
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    const: '20'
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [624, 360.0]
    rotation: 0
    state: enabled
- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport serial\n\n\n\
      class blk(gr.sync_block):\n    def __init__(self):\n        gr.sync_block.__init__(self,\
      \ name='BeeSDR',\n                               in_sig=[np.complex64], out_sig=None)\n\
      \        self.port = 'COM3'\n        self.ser = None\n\n    def start(self):\n\
      \        self.ser = serial.Serial(self.port)\n        self.ser.reset_output_buffer()\n\
      \        return True\n\n    def work(self, input_items, output_items):\n   \
      \     x = input_items[0]\n        buf = np.empty(2 * len(x), np.uint8)\n   \
      \     buf[0::2] = (64 + 63 * np.clip(x.real, -1, 1)).astype(np.uint8)  # I ->\
      \ DAC1 OUT1\n        buf[1::2] = (64 + 63 * np.clip(x.imag, -1, 1)).astype(np.uint8)\
      \  # Q -> DAC1 OUT2\n        self.ser.write(buf.tobytes())\n        return len(x)\n\
      \n    def stop(self):\n        if self.ser:\n            self.ser.close()\n\
      \            self.ser = None\n        return True"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('BeeSDR', 'blk', [], [('0', 'complex', 1)], [], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1112, 368.0]
    rotation: 0
    state: enabled
- name: rational_resampler_xxx_0
  id: rational_resampler_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    decim: '192'
    fbw: '0'
    interp: '200'
    maxoutbuf: '0'
    minoutbuf: '0'
    taps: '[]'
    type: fff
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 332.0]
    rotation: 0
    state: enabled

connections:
- [analog_sig_source_x_0, '0', epy_block_0, '0']
- [audio_source_0, '0', rational_resampler_xxx_0, '0']
- [blocks_float_to_complex_0, '0', epy_block_0, '0']
- [blocks_multiply_const_vxx_0, '0', blocks_float_to_complex_0, '0']
- [blocks_multiply_const_vxx_0, '0', blocks_float_to_complex_0, '1']
- [rational_resampler_xxx_0, '0', blocks_multiply_const_vxx_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.12.0
